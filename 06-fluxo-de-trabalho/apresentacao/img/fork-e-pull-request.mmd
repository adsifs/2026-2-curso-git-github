---
config:
  theme: base
  # fontFamily precisa ser chave de topo — dentro de themeVariables é ignorada
  fontFamily: "Helvetica Neue, Helvetica, Arial, sans-serif"
  themeVariables:
    fontSize: 22px
    lineColor: "#f05033"
    primaryColor: "#fdeeeb"
    primaryTextColor: "#1a1a1a"
    primaryBorderColor: "#f05033"
    edgeLabelBackground: "#fdfdfb"
  flowchart:
    nodeSpacing: 65
    rankSpacing: 90
    padding: 20
---
flowchart LR
    ORIG["<b>REPOSITÓRIO ORIGINAL</b><br><br>github.com/<br>outra-pessoa<br><i>você não escreve aqui</i>"]
    FORK["<b>SEU FORK</b><br><br>github.com/voce<br><i>controle total</i>"]
    LOCAL["<b>SUA MÁQUINA</b><br><br>a pasta clonada"]

    ORIG -->|"<b>1.</b> fork"| FORK
    FORK -->|"<b>2.</b> clone"| LOCAL
    LOCAL -->|"<b>3.</b> push"| FORK
    FORK -->|"<b>4.</b> Pull Request"| ORIG

    classDef caixa fill:#fdeeeb,stroke:#f05033,stroke-width:4px,color:#1a1a1a
    classDef alheio fill:#f6f4ef,stroke:#8f8f8f,stroke-width:4px,color:#1a1a1a
    class FORK,LOCAL caixa
    class ORIG alheio

    linkStyle 0,1,2,3 stroke:#f05033,stroke-width:3.5px
