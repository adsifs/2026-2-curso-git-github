---
config:
  theme: base
  # fontFamily precisa ser chave de topo — dentro de themeVariables é ignorada
  fontFamily: "Helvetica Neue, Helvetica, Arial, sans-serif"
  themeVariables:
    fontSize: 23px
    lineColor: "#f05033"
    primaryColor: "#fdeeeb"
    primaryTextColor: "#1a1a1a"
    primaryBorderColor: "#f05033"
    edgeLabelBackground: "#fdfdfb"
  flowchart:
    nodeSpacing: 55
    padding: 20
---
flowchart LR
    A["<b>1. Gerar</b><br><br>Settings →<br>Developer settings"]
    B["<b>2. Copiar</b><br><br>exibido uma<br>única vez"]
    C["<b>3. Guardar</b><br><br>gerenciador<br>de senhas"]
    D["<b>4. Colar</b><br><br>no campo Password<br>do git push"]

    A --> B --> C --> D

    classDef caixa fill:#fdeeeb,stroke:#f05033,stroke-width:4px,color:#1a1a1a
    classDef final fill:#f05033,stroke:#c93d24,stroke-width:4px,color:#ffffff
    class A,B,C caixa
    class D final

    linkStyle 0,1,2 stroke:#f05033,stroke-width:3.5px
