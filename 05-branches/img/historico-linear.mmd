---
config:
  theme: base
  # fontFamily precisa ser chave de topo — dentro de themeVariables é ignorada
  fontFamily: "Helvetica Neue, Helvetica, Arial, sans-serif"
  themeVariables:
    git0: "#f05033"
    gitBranchLabel0: "#ffffff"
    commitLabelColor: "#1a1a1a"
    commitLabelBackground: "#fdfdfb"
    commitLabelFontSize: "20px"
  gitGraph:
    rotateCommitLabel: false
---
gitGraph
    commit id: "A"
    commit id: "B"
    commit id: "C"
